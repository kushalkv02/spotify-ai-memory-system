# Neo4j connection used by graph.services.recommendation_service.
# Copy this file to .env and replace the password with your database password.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Optional Neo4j driver tuning.
# NEO4J_MAX_CONN_LIFETIME=3600
# NEO4J_MAX_POOL_SIZE=50
# NEO4J_CONN_TIMEOUT=60

# Optional MCP settings, only needed when starting spotify_mcp.
# MCP_SERVER_NAME=spotify-memory
# MCP_SERVER_VERSION=0.1.0
# MCP_TRANSPORT=stdio

# Base URL of the interaction-api service
VITE_API_BASE_URL=http://localhost:8000

# Dev-only: sent as X-User-Id header (matches interaction-api's dev auth bypass)
VITE_DEV_USER_ID=user_0110

INTERACTION_API_GEMINI_API_KEY=your-gemini-api-key
# Optional: defaults to gemini-2.5-flash
INTERACTION_API_GEMINI_MODEL=gemini-3.5-flash